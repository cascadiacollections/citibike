{
  "name": "citibike",
  "description": "Citi Bike NYC (GBFS) client library for Node.js: stations, live availability and nearest-station lookup",
  "version": "3.0.0",
  "homepage": "https://github.com/cascadiacollections/citibike",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cascadiacollections/citibike.git"
  },
  "keywords": [
    "citibikenyc",
    "citi",
    "bike",
    "nyc",
    "api",
    "citibike",
    "gbfs",
    "bikeshare",
    "transportation",
    "stations",
    "ebike",
    "typescript"
  ],
  "contributors": [
    "Brad Dickason <https://twitter.com/bdickason>",
    "David Mazza <http://www.davidmazza.com/>"
  ],
  "license": "MIT",
  "main": "./lib/citibike.js",
  "types": "./lib/citibike.d.ts",
  "exports": {
    ".": {
      "types": "./lib/citibike.d.ts",
      "default": "./lib/citibike.js"
    },
    "./lib/citibike.js": "./lib/citibike.js",
    "./lib/citibike": "./lib/citibike.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "mocha && npm run test:types",
    "test:types": "node scripts/typecheck.js",
    "docs": "node scripts/build-docs.js",
    "docs:check": "node scripts/check-site.js",
    "snapshot": "node scripts/snapshot-stations.js"
  },
  "devDependencies": {
    "mocha": "^12.0.3",
    "should": "^13.2.3",
    "typescript": "^7.0.2"
  },
  "sideEffects": false
}

{
  "name": "citibike",
  "description": "Citi Bike NYC (GBFS) client library for Node.js: stations, live availability and nearest-station lookup",
  "version": "3.0.0",
  "homepage": "https://github.com/cascadiacollections/citibike",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cascadiacollections/citibike.git"
  },
  "keywords": [
    "citibikenyc",
    "citi",
    "bike",
    "nyc",
    "api",
    "citibike",
    "gbfs",
    "bikeshare",
    "transportation",
    "stations",
    "ebike",
    "typescript"
  ],
  "contributors": [
    "Brad Dickason <https://twitter.com/bdickason>",
    "David Mazza <http://www.davidmazza.com/>"
  ],
  "license": "MIT",
  "type": "commonjs",
  "main": "./lib/citibike.js",
  "types": "./lib/citibike.d.ts",
  "exports": {
    ".": {
      "types": "./lib/citibike.d.ts",
      "default": "./lib/citibike.js"
    },
    "./lib/citibike.js": "./lib/citibike.js",
    "./lib/citibike": "./lib/citibike.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "test": "node --test \"test/*.test.js\" \"test/*.test.mjs\" && npm run test:types",
    "test:types": "node scripts/typecheck.js",
    "test:bun": "bun run build && bun test ./test/",
    "coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=\"lib/**\" --test-coverage-include=\"src/**\" --test-coverage-include=\"scripts/snapshot-stations.js\" --test-coverage-include=\"worker/src/**\" --test-coverage-lines=99 --test-coverage-branches=98 --test-coverage-functions=98 \"test/*.test.js\" \"test/*.test.mjs\"",
    "check:pkg": "publint --strict && attw --pack .",
    "docs": "node scripts/build-docs.js",
    "docs:check": "node scripts/check-site.js",
    "snapshot": "node scripts/snapshot-stations.js"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.7",
    "publint": "^0.3.25",
    "typescript": "^7.0.2"
  },
  "sideEffects": false
}

{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",

    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "sourceMap": false,
    "declarationMap": false,
    "removeComments": false,
    "newLine": "lf",
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
